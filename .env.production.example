# ===========================================
# shinBlog Production Environment Variables
# ===========================================
# Copy this file to .env.production and fill in the values
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# --- Database ---
DB_PASSWORD=change_me_to_a_strong_password

# --- NextAuth ---
NEXTAUTH_URL=https://arcadiakokoro.com
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# --- Admin ---
ADMIN_EMAIL=your@email.com

# --- RAG (Kokoron) ---
OPENAI_API_KEY=sk-your-openai-api-key

# --- Koclaw (optional, leave empty to disable) ---
KOCLAW_GATEWAY_URL=
NEXT_PUBLIC_KOCLAW_WS_URL=
NEXT_PUBLIC_KOCLAW_ASSETS_URL=
